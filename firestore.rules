rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function roleIn(roles) {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in roles;
    }
    function fullAdmin() { return roleIn(['admin']); }
    function moderator() { return roleIn(['admin', 'moderator']); }
    function support() { return roleIn(['admin', 'moderator', 'staff']); }
    function contentAuthor() { return roleIn(['admin', 'coach']); }
    function activeOwner(uid) {
      return owner(uid) && (!exists(/databases/$(database)/documents/users/$(uid))
        || get(/databases/$(database)/documents/users/$(uid)).data.get('suspended', false) != true);
    }
    function noPrivilegeFields() { return !request.resource.data.keys().hasAny(['role', 'suspended']); }
    function privilegesUnchanged() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'suspended']); }
    function suspensionOnly(uid) {
      return moderator() && !exists(/databases/$(database)/documents/admins/$(uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended'])
        && request.resource.data.suspended is bool;
    }
    match /users/{uid} {
      allow read: if owner(uid) || roleIn(['admin', 'moderator', 'readonly']);
      allow create: if (owner(uid) && noPrivilegeFields()) || fullAdmin();
      allow update: if (activeOwner(uid) && privilegesUnchanged()) || fullAdmin() || suspensionOnly(uid);
      allow delete: if fullAdmin();
      match /profile/{id} {
        allow read: if owner(uid) || fullAdmin();
        allow create: if (activeOwner(uid) && noPrivilegeFields()) || fullAdmin();
        allow update: if (activeOwner(uid) && privilegesUnchanged()) || fullAdmin() || suspensionOnly(uid);
        allow delete: if activeOwner(uid) || fullAdmin();
      }
      // Exclude privilege-bearing invite documents from the generic owner rule.
      match /{collectionId}/{document=**} {
        allow read: if collectionId != 'adminInvites' && collectionId != 'profile' && (owner(uid) || fullAdmin());
        allow write: if collectionId != 'adminInvites' && collectionId != 'profile' && (activeOwner(uid) || fullAdmin());
      }
      match /adminInvites/{inviteId} {
        allow read, delete: if owner(uid) || fullAdmin();
        allow create, update: if fullAdmin() && request.resource.data.role in ['admin', 'moderator', 'staff', 'coach'];
      }
    }
    function validInvite(uid) {
      let incoming = request.resource.data;
      return owner(uid) && incoming.keys().hasOnly(['role', 'grantedAt', 'grantedFromInvite'])
        && incoming.keys().hasAll(['role', 'grantedAt', 'grantedFromInvite'])
        && incoming.grantedFromInvite is string
        && incoming.grantedAt == request.time
        && exists(/databases/$(database)/documents/users/$(uid)/adminInvites/$(incoming.grantedFromInvite))
        && get(/databases/$(database)/documents/users/$(uid)/adminInvites/$(incoming.grantedFromInvite)).data.role == incoming.role
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/adminInvites/$(incoming.grantedFromInvite));
    }
    match /admins/{uid} {
      allow read: if owner(uid) || roleIn(['admin', 'moderator']);
      allow create: if request.resource.data.role in ['admin', 'moderator', 'staff', 'coach', 'readonly'] && (fullAdmin() || validInvite(uid));
      allow update: if fullAdmin() && request.resource.data.role in ['admin', 'moderator', 'staff', 'coach', 'readonly'];
      allow delete: if fullAdmin();
    }
    match /library_workouts/{id} {
      allow read: if signedIn();
      allow create, update, delete: if contentAuthor();
    }
    match /library_mealPlans/{id} {
      allow read: if signedIn();
      allow create, update, delete: if contentAuthor();
    }
    match /activityLogs/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.keys().hasAll(['userId', 'action', 'createdAt']);
      allow read: if roleIn(['admin', 'moderator', 'readonly']);
      allow update, delete: if fullAdmin();
    }
    match /announcements/{id} {
      allow read: if signedIn();
      allow create, update, delete: if fullAdmin();
    }
    function ticketAccess(id) {
      return signedIn() && (get(/databases/$(database)/documents/supportTickets/$(id)).data.userId == request.auth.uid || support());
    }
    match /supportTickets/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || support());
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || support())
        && request.resource.data.userId == resource.data.userId;
      allow delete: if fullAdmin();
      match /messages/{messageId} {
        allow read: if ticketAccess(id);
        allow create: if ticketAccess(id) && request.resource.data.authorId == request.auth.uid
          && request.resource.data.body is string && request.resource.data.body.size() > 0
          && ((request.resource.data.authorRole == 'admin' && support())
            || (request.resource.data.authorRole == 'user' && get(/databases/$(database)/documents/supportTickets/$(id)).data.userId == request.auth.uid));
        allow update, delete: if fullAdmin();
      }
    }
    function assignmentAccess(id) {
      return fullAdmin() || (roleIn(['coach']) && get(/databases/$(database)/documents/coachAssignments/$(id)).data.coachId == request.auth.uid);
    }
    match /coachAssignments/{id} {
      allow read: if fullAdmin() || (roleIn(['coach']) && resource.data.coachId == request.auth.uid);
      allow create, update: if fullAdmin()
        && request.resource.data.coachId is string && request.resource.data.memberId is string
        && request.resource.data.memberName is string && request.resource.data.goal is string
        && request.resource.data.status in ['active', 'archived']
        && get(/databases/$(database)/documents/admins/$(request.resource.data.coachId)).data.role == 'coach'
        && exists(/databases/$(database)/documents/users/$(request.resource.data.memberId));
      allow delete: if fullAdmin();
      match /checkIns/{id2} {
        allow read: if assignmentAccess(id);
        allow create: if assignmentAccess(id)
          && get(/databases/$(database)/documents/coachAssignments/$(id)).data.status == 'active'
          && request.resource.data.keys().hasOnly(['coachId', 'body', 'nextDate', 'createdAt'])
          && request.resource.data.coachId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 4000;
        allow update, delete: if fullAdmin();
      }
    }
    match /siteSettings/{id} { allow read: if true; allow write: if fullAdmin(); }
    match /featureFlags/{id} { allow read: if true; allow write: if fullAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
