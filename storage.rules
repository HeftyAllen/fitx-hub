rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function fullAdmin() {
      return signedIn() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid}/{path=**} {
      allow read: if owner(uid) || fullAdmin();
      allow create, update: if owner(uid) && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if owner(uid) || fullAdmin();
    }
    match /public/branding/{path=**} {
      allow read: if true;
      allow create, update: if fullAdmin() && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/png|image/jpeg|image/webp|image/x-icon|image/vnd.microsoft.icon');
      allow delete: if fullAdmin();
    }
    match /public/{folder}/{path=**} {
      allow read: if true;
      allow write: if folder != 'branding' && fullAdmin();
    }
    match /public/{filename} { allow read: if true; allow write: if fullAdmin(); }
    match /{path=**} { allow read, write: if false; }
  }
}
